# ═══════════════════════════════════════════════════════════
# IEEE Volunteer Connect — frontend build variables (all optional)
# ═══════════════════════════════════════════════════════════
# Copy to .env.local if you need them:  copy .env.example .env.local
#
# Backend secrets do NOT go here — set them on Cloudflare with
#   npx wrangler secret put <NAME>
# (see README → "Deploy to Cloudflare"), or in .dev.vars for local dev.

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Sentry browser DSN for remote error reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
